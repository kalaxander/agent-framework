# Copy this file to .env and fill in real values for local use — .env itself is gitignored so
# your real keys never get committed. Deployment platforms (Render/Railway) have their own
# environment variable settings in their dashboard; you don't need a .env file there.

# Optional — falls back to MockLLMProvider if unset. Get a free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional alternative to Gemini (checked second). Paid API.
ANTHROPIC_API_KEY=

# Optional — falls back to InMemoryStateStore (data lost on restart) if unset.
# Get a free Postgres: https://neon.tech or https://supabase.com
DATABASE_URL=

# Set automatically by Render/Railway — only needed locally if you want a non-default port.
PORT=8000
